# Spravováno Ansible – ručně neupravovat
[global]
   workgroup = {{ samba_workgroup }}
   server role = standalone server
   server min protocol = SMB2
   map to guest = never
   disable netbios = yes
   smb ports = 445
   log file = /var/log/samba/log.%m
   max log size = 1000

{% for share in samba_shares %}
[{{ share.name }}]
   path = {{ share.path }}
   comment = {{ share.comment | default(share.name) }}
   read only = {{ share.read_only | default('yes') }}
   browseable = {{ share.browseable | default('yes') }}
   valid users = {{ share.valid_users }}
   create mask = {{ share.create_mask | default('0660') }}
   directory mask = {{ share.directory_mask | default('2770') }}

{% endfor %}
